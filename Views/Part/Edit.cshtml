@model Zentro.Models.PartEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm Part" : "Sửa Part"; ViewData["Menu"] = "parts"; }
<h1 class="hmi-page-title">@ViewData["Title"]</h1><div class="hmi-panel"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="hmi-error"></div><div class="hmi-filter-grid"><div><label asp-for="MaIndex">MÃ INDEX</label><input asp-for="MaIndex" class="hmi-input" /></div><div><label asp-for="MaSp">MÃ SẢN PHẨM</label><input asp-for="MaSp" class="hmi-input" /></div><div><label asp-for="TenChiTiet">TÊN CHI TIẾT</label><input asp-for="TenChiTiet" class="hmi-input" /></div><div><label asp-for="MaMay">MÁY ĐƯỢC PHÂN CÔNG</label><select asp-for="MaMay" class="hmi-input"><option value="">Tất cả máy</option>@foreach (var machine in Model.Machines) { <option value="@machine.MaMay">@machine.MaMay - @machine.Ten</option> }</select></div></div><div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">LƯU</button><a class="hmi-btn" asp-action="Index">HỦY</a></div></form></div>