@model Zentro.Models.KpiReportViewModel
@{ ViewData["Title"] = "Báo cáo KPI"; ViewData["Menu"] = "kpi"; }
<h1 class="hmi-page-title">BÁO CÁO KPI</h1>
<div class="hmi-panel"><form asp-action="Kpi" method="get"><div class="hmi-filter-grid"><div><label>KỲ</label><select class="hmi-input" name="period"><option value="day" selected="@(Model.Period == "day" ? "selected" : null)">Ngày</option><option value="week" selected="@(Model.Period == "week" ? "selected" : null)">Tuần</option><option value="month" selected="@(Model.Period == "month" ? "selected" : null)">Tháng</option></select></div><div><label>TỪ NGÀY</label><input class="hmi-input" type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div><div><label>ĐẾN NGÀY</label><input class="hmi-input" type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div><div><label>MÁY</label><select class="hmi-input" name="maMay">@foreach (var item in Model.MachineOptions) { <option value="@item" selected="@(item == Model.MaMay ? "selected" : null)">@item</option> }</select></div><div><label>MÃ SP</label><select class="hmi-input" name="maSp">@foreach (var item in Model.ProductOptions) { <option value="@item" selected="@(item == Model.MaSp ? "selected" : null)">@item</option> }</select></div></div><div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">XEM KPI</button><a class="hmi-btn" asp-action="ExportKpiExcel" asp-route-period="@Model.Period" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-maMay="@Model.MaMay" asp-route-maSp="@Model.MaSp">XUẤT EXCEL</a></div></form></div>
<div class="hmi-panel"><div class="hmi-grid-4"><div class="hmi-stat"><div class="hmi-stat-label">SẢN LƯỢNG</div><div class="hmi-stat-value hmi-info">@Model.TongSanLuong</div></div><div class="hmi-stat"><div class="hmi-stat-label">SỐ LẦN GIA CÔNG</div><div class="hmi-stat-value">@Model.SoLanGiaCong</div></div><div class="hmi-stat"><div class="hmi-stat-label">OK / NG</div><div class="hmi-stat-value"><span class="hmi-running">@Model.SanPhamDat</span> / <span class="hmi-warning">@Model.SanPhamLoi</span></div></div><div class="hmi-stat"><div class="hmi-stat-label">HIỆU SUẤT</div><div class="hmi-stat-value hmi-running">@Model.HieuSuatPercent.ToString("0.0")%</div></div></div></div>
<div class="hmi-panel"><div class="hmi-panel-title">CHI TIẾT GIA CÔNG</div><table class="hmi-table"><thead><tr><th>MÁY</th><th>INDEX</th><th>MÃ SP</th><th>CHI TIẾT</th><th>NHÂN VIÊN</th><th>BẮT ĐẦU</th><th>KẾT QUẢ</th></tr></thead><tbody>@if (Model.MachiningRows.Count == 0) { <tr><td colspan="7">Không có dữ liệu trong khoảng chọn.</td></tr> } @foreach (var row in Model.MachiningRows) { <tr><td>@row.MaMay</td><td>@row.MaIndex</td><td>@row.MaSp</td><td>@row.TenChiTiet</td><td>@row.Username</td><td>@row.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@row.KetQua</td></tr> }</tbody></table></div>
<div class="hmi-panel"><div class="hmi-panel-title">SỰ CỐ TRONG KỲ: @Model.SoSuCo</div><table class="hmi-table"><thead><tr><th>THIẾT BỊ</th><th>NỘI DUNG</th><th>THỜI GIAN</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach (var alarm in Model.Alarms) { <tr><td>@alarm.ThietBi</td><td>@alarm.NoiDung</td><td>@alarm.ThoiGian</td><td>@alarm.TrangThai</td></tr> }</tbody></table></div>