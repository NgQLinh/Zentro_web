@model List<Zentro.Models.MachineRecord>
@{ ViewData["Title"] = "Quản lý máy"; ViewData["Menu"] = "may"; var history = ViewBag.History as List<Zentro.Models.MachineStatusHistoryRecord> ?? new(); }
<h1 class="hmi-page-title">QUẢN LÝ MÁY</h1>
<div class="hmi-btn-row"><a class="hmi-btn hmi-btn-green" asp-action="Create">THÊM MÁY</a></div>
<div class="hmi-panel"><div class="hmi-panel-title">DANH SÁCH MÁY</div><table class="hmi-table"><thead><tr><th>MÃ MÁY</th><th>TÊN MÁY</th><th>IP PLC</th><th>CỔNG</th><th>TRẠNG THÁI</th><th>KẾT NỐI</th><th>THAO TÁC</th></tr></thead><tbody>@foreach (var machine in Model) { <tr><td>@machine.MaMay</td><td>@machine.Ten</td><td>@machine.IpPlc</td><td>@machine.PortPlc</td><td class="@(machine.TrangThai == "RUNNING" ? "hmi-running" : machine.TrangThai == "ALARM" ? "hmi-error" : "hmi-warning")">@machine.TrangThai</td><td class="@(machine.PlcOnline ? "hmi-running" : "hmi-error")">@(machine.PlcOnline ? "ONLINE" : "OFFLINE")</td><td><a class="hmi-btn" asp-action="Edit" asp-route-id="@machine.MaMay">SỬA</a><form asp-action="Delete" method="post" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@machine.MaMay" /><button class="hmi-btn hmi-btn-red" type="submit">XÓA</button></form></td></tr> }</tbody></table></div>
<div class="hmi-panel"><div class="hmi-panel-title">LỊCH SỬ TRẠNG THÁI</div><form method="get" class="hmi-filter-grid"><div><label>MÁY</label><select name="maMay" class="hmi-input"><option value="">Tất cả</option>@foreach (var machine in Model) { <option value="@machine.MaMay" selected="@(ViewBag.HistoryMachine == machine.MaMay ? "selected" : null)">@machine.MaMay - @machine.Ten</option> }</select></div><div><label>TỪ NGÀY</label><input name="fromDate" type="date" class="hmi-input" value="@ViewBag.HistoryFrom" /></div><div><label>ĐẾN NGÀY</label><input name="toDate" type="date" class="hmi-input" value="@ViewBag.HistoryTo" /></div><div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">LỌC</button><a class="hmi-btn" asp-action="Index">ĐẶT LẠI</a></div></form><div class="hmi-grid-3"><div class="hmi-stat"><div class="hmi-stat-label">RUNNING</div><div class="hmi-stat-value hmi-running">@TimeSpan.FromSeconds((int)ViewBag.RunningSeconds)</div></div><div class="hmi-stat"><div class="hmi-stat-label">STOPPED / PAUSED</div><div class="hmi-stat-value hmi-warning">@TimeSpan.FromSeconds((int)ViewBag.StoppedSeconds)</div></div><div class="hmi-stat"><div class="hmi-stat-label">ALARM</div><div class="hmi-stat-value hmi-error">@TimeSpan.FromSeconds((int)ViewBag.AlarmSeconds)</div></div></div><h3 class="hmi-panel-title">THỐNG KÊ DỪNG THEO NGUYÊN NHÂN</h3><table class="hmi-table"><thead><tr><th>NGUYÊN NHÂN</th><th>SỐ LẦN</th><th>TỔNG THỜI LƯỢNG</th></tr></thead><tbody>@foreach (var reason in (ViewBag.DowntimeReasons as Dictionary<string, (int Count, int Seconds)> ?? new())) { <tr><td>@reason.Key</td><td>@reason.Value.Count</td><td>@TimeSpan.FromSeconds(reason.Value.Seconds)</td></tr> }</tbody></table><table class="hmi-table"><thead><tr><th>BẮT ĐẦU</th><th>KẾT THÚC</th><th>MÁY</th><th>TỪ</th><th>SANG</th><th>THỜI LƯỢNG</th><th>LÝ DO DỪNG</th><th>NGƯỜI THỰC HIỆN</th><th>NGUỒN</th><th>GHI CHÚ</th></tr></thead><tbody>@foreach (var item in history) { var duration = item.ThoiLuongGiay ?? Math.Max(0, (int)(DateTime.Now - item.ThoiDiem).TotalSeconds); <tr><td>@item.ThoiDiem.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.ThoiDiemKetThuc?.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.MaMay</td><td>@item.TrangThaiCu</td><td>@item.TrangThaiMoi</td><td>@TimeSpan.FromSeconds(duration)</td><td>@item.LyDoDung</td><td>@item.NguoiThucHien</td><td>@item.Nguon</td><td>@item.GhiChu</td></tr> }</tbody></table></div>