@model Zentro.Models.MachineEditViewModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm máy" : "Sửa máy"; ViewData["Menu"] = "may"; }
<h1 class="hmi-page-title">@ViewData["Title"]</h1><div class="hmi-panel"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="IsNew" type="hidden" /><div asp-validation-summary="ModelOnly" class="hmi-error"></div><div class="hmi-filter-grid"><div><label asp-for="MaMay">MÃ MÁY</label><input asp-for="MaMay" class="hmi-input" readonly="@(!Model.IsNew)" /></div><div><label asp-for="Ten">TÊN MÁY</label><input asp-for="Ten" class="hmi-input" /></div><div><label asp-for="IpPlc">IP PLC</label><input asp-for="IpPlc" class="hmi-input" /></div><div><label asp-for="PortPlc">CỔNG PLC</label><input asp-for="PortPlc" class="hmi-input" type="number" /></div><div><label asp-for="BangTaiMap">MÃ BĂNG TẢI</label><input asp-for="BangTaiMap" class="hmi-input" /></div></div><p><label><input asp-for="IsActive" /> ĐANG HOẠT ĐỘNG</label></p><div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">LƯU</button><a class="hmi-btn" asp-action="Index">HỦY</a></div></form></div>