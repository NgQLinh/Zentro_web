@model Zentro.Models.BangTaiModel
@{
    ViewData["Title"] = "Trạm phân loại";
}

<h1 class="hmi-page-title">TRẠM PHÂN LOẠI SẢN PHẨM</h1>
<div class="hmi-status-bar @(Model.DangXuLy ? "running" : Model.LoiMay ? "alarm" : "stopped")">@(Model.DangXuLy ? "PROCESSING" : Model.TrangThai)</div>

<div class="hmi-grid-4">
    <div class="hmi-stat"><div class="hmi-stat-label">TỔNG</div><div class="hmi-stat-value">@Model.SoSanPham</div></div>
    @foreach (var loai in BangTaiModel.LoaiLinhKien)
    {
        <div class="hmi-stat"><div class="hmi-stat-label">@loai.ToUpperInvariant()</div><div class="hmi-stat-value hmi-info">@Model.SoLuongTheoLoai[loai]</div></div>
    }
    <div class="hmi-stat"><div class="hmi-stat-label">LỖI</div><div class="hmi-stat-value hmi-warning">@Model.SoLoi</div></div>
</div>

<div class="hmi-panel">
    <div class="hmi-panel-title">MÔ PHỎNG NHẬN DIỆN</div>
    <div class="hmi-flow">
        <div class="hmi-flow-box @(Model.CamBien ? "on" : "")">[ CB01 | @(Model.CamBien ? "ACTIVE" : "READY") ]</div><span class="hmi-flow-arrow">→</span>
        <div class="hmi-flow-box @(Model.DangXuLy ? "on" : "")">[ PHÂN LOẠI | @(Model.DangXuLy ? "BUSY" : "IDLE") ]</div>
        <span class="hmi-flow-arrow">→</span><div class="hmi-flow-box">[ CƠ CẤU ĐẨY ]</div>
    </div>
    <div class="hmi-btn-row">
        @foreach (var loai in BangTaiModel.LoaiLinhKien)
        {
            <a class="hmi-btn hmi-btn-green" asp-route="classification" asp-route-loai="@loai">@loai.ToUpperInvariant()</a>
        }
        <a class="hmi-btn hmi-btn-yellow" asp-route="classification" asp-route-loai="LOI">SẢN PHẨM LỖI</a>
    </div>
</div>

<div class="hmi-grid-3">
    <div class="hmi-panel"><div class="hmi-panel-title">CƠ CẤU ĐẨY 1</div><div class="hmi-stat-value @(Model.XyLanhA ? "hmi-running" : "")">@(Model.XyLanhA ? "ON" : "OFF")</div></div>
    <div class="hmi-panel"><div class="hmi-panel-title">CƠ CẤU ĐẨY 2</div><div class="hmi-stat-value @(Model.XyLanhB ? "hmi-running" : "")">@(Model.XyLanhB ? "ON" : "OFF")</div></div>
    <div class="hmi-panel"><div class="hmi-panel-title">CẢM BIẾN</div><div class="hmi-stat-value @(Model.CamBien ? "hmi-running" : "")">@(Model.CamBien ? "ON" : "OFF")</div></div>
</div>

<div class="hmi-panel"><div class="hmi-panel-title">LỊCH SỬ PHÂN LOẠI</div><table class="hmi-table"><thead><tr><th>MÃ SP</th><th>LOẠI</th><th>KẾT QUẢ</th><th>THỜI GIAN</th></tr></thead><tbody>
@if (Model.ProductHistory.Count == 0) { <tr><td colspan="4">Chưa có sản phẩm được phân loại.</td></tr> }
@foreach (var item in Model.ProductHistory) { <tr><td>@item.MaSp</td><td>@item.Loai</td><td class="@(item.KetQua == "Lỗi" ? "hmi-error" : "hmi-running")">@item.KetQua</td><td>@item.ThoiGian</td></tr> }
</tbody></table></div>