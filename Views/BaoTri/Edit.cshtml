@model Zentro.Models.MaintenanceEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Tạo lịch bảo trì" : "Sửa lịch bảo trì"; ViewData["Menu"] = "baotri"; }
<h1 class="hmi-page-title">@ViewData["Title"]</h1>
<div class="hmi-panel"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="hmi-error"></div><div class="hmi-filter-grid"><div><label asp-for="ThietBi">MÁY</label><select asp-for="ThietBi" class="hmi-input">@foreach (var machine in Model.Machines) { <option value="@machine.MaMay">@machine.MaMay - @machine.Ten</option> }</select><span asp-validation-for="ThietBi" class="hmi-error"></span></div><div><label asp-for="Loai">LOẠI</label><input asp-for="Loai" class="hmi-input" /><span asp-validation-for="Loai" class="hmi-error"></span></div><div><label asp-for="NgayBt">NGÀY BẢO TRÌ</label><input asp-for="NgayBt" class="hmi-input" type="date" /><span asp-validation-for="NgayBt" class="hmi-error"></span></div><div><label asp-for="LanTiepTheo">LẦN TIẾP THEO</label><input asp-for="LanTiepTheo" class="hmi-input" type="date" /><span asp-validation-for="LanTiepTheo" class="hmi-error"></span></div><div><label asp-for="NguoiThucHien">NGƯỜI THỰC HIỆN</label><input asp-for="NguoiThucHien" class="hmi-input" /><span asp-validation-for="NguoiThucHien" class="hmi-error"></span></div><div><label asp-for="TrangThai">TRẠNG THÁI</label><select asp-for="TrangThai" class="hmi-input"><option>ĐÃ LÊN LỊCH</option><option>ĐANG BẢO TRÌ</option><option>HOÀN TẤT</option><option>HỦY</option></select></div></div><div><label asp-for="GhiChu">GHI CHÚ</label><textarea asp-for="GhiChu" class="hmi-input"></textarea><span asp-validation-for="GhiChu" class="hmi-error"></span></div><div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">LƯU</button><a class="hmi-btn" asp-action="Index">HỦY</a></div></form></div>