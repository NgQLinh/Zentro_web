@model Zentro.Models.TaiKhoanEditViewModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm tài khoản" : "Sửa tài khoản"; ViewData["Menu"] = "taikhoan"; }
<h1 class="hmi-page-title">@ViewData["Title"]</h1><div class="hmi-panel"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="IsNew" type="hidden" /><div asp-validation-summary="ModelOnly" class="hmi-error"></div><div class="hmi-filter-grid"><div><label asp-for="Username">TÀI KHOẢN</label><input asp-for="Username" class="hmi-input" readonly="@(!Model.IsNew)" /></div><div><label asp-for="Password">MẬT KHẨU</label><input asp-for="Password" class="hmi-input" type="password" /></div><div><label asp-for="Role">QUYỀN</label><select asp-for="Role" class="hmi-input"><option>User</option><option>Maintenance</option><option>Admin</option></select></div></div><p><label><input asp-for="IsActive" /> ĐANG HOẠT ĐỘNG</label></p><div class="hmi-panel-title">MÁY ĐƯỢC PHÂN CÔNG</div>@foreach (var machine in Model.AllMachines) { <label style="display:block"><input type="checkbox" name="SelectedMachines" value="@machine.MaMay" checked="@(Model.SelectedMachines.Contains(machine.MaMay) ? "checked" : null)" /> @machine.MaMay - @machine.Ten</label> }<div class="hmi-btn-row"><button class="hmi-btn hmi-btn-green" type="submit">LƯU</button><a class="hmi-btn" asp-action="Index">HỦY</a></div></form></div>